{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ausbildungs-Cockpit",
  "version": "0.1.0",
  "identifier": "io.github.ch3rry-glitch.ausbildungs-cockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ausbildungs-Cockpit",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#140a2e"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "Ausbildungs-Cockpit für den Obsidian-Lernvault",
    "longDescription": "Zweite, schnellere Oberfläche auf den Obsidian-Lernvault: Unterrichtsnotizen, Aufgaben, Berichtsheft und Logbucheinträge für Moodle.",
    "copyright": "© 2026 Ausbildungs-Cockpit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
